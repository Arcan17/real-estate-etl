# Real Estate ETL — environment configuration
# Copy to .env and adjust as needed. All variables have safe defaults.

# ── Scraper ────────────────────────────────────────────────────────────────────

# Base listing URL to scrape (Portal Inmobiliario — Santiago rentals by default)
BASE_URL=https://www.portalinmobiliario.com/arriendo/departamento/santiago-metropolitana

# Number of pages to scrape per run (~48 listings per page)
MAX_PAGES=5

# Polite delay between page requests (seconds, random between min and max)
SCRAPE_DELAY_MIN=1.5
SCRAPE_DELAY_MAX=3.0

# ── API ────────────────────────────────────────────────────────────────────────

# Comma-separated allowed CORS origins. Use "*" for local development.
# Example for production: CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
CORS_ORIGINS=*
